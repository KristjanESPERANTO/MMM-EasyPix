{
  "name": "mmm-easypix",
  "version": "1.1.10",
  "description": "A module for MagicMirror² to display pictures.",
  "keywords": [
    "MagicMirror",
    "images",
    "photos",
    "pictures"
  ],
  "homepage": "https://github.com/KristjanESPERANTO/MMM-EasyPix#readme",
  "bugs": {
    "url": "https://github.com/KristjanESPERANTO/MMM-EasyPix/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KristjanESPERANTO/MMM-EasyPix"
  },
  "license": "MIT",
  "author": {
    "name": "mykle1",
    "url": "https://github.com/mykle1"
  },
  "contributors": [
    {
      "name": "MMM-EasyPix contributors",
      "url": "https://github.com/KristjanESPERANTO/MMM-EasyPix/contributors"
    }
  ],
  "type": "module",
  "main": "MMM-EasyPix.js",
  "scripts": {
    "lint": "eslint && prettier --check .",
    "lint:fix": "eslint --fix && prettier --write .",
    "prepare": "simple-git-hooks || true",
    "test": "node --run lint && node --run test:spelling",
    "test:spelling": "cspell ."
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "cspell": "^10.2.2",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "unrs-resolver@1.12.2": true
  }
}
